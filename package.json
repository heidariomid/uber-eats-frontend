    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.5.2",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^16.11.36",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.4",
    "cypress": "^10.1.0",
    "filestack-js": "^3.25.0",
    "graphql": "^16.5.0",
    "graphql-ws": "^5.9.1",
    "leaflet": "^1.9.4",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-hook-form": "^7.90.0",
    "react-leaflet": "^4.0.1",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "redux-saga": "^1.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^4.9.5",
    "uuid": "^8.3.2",
    "victory": "^37.3.6",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "CI=false react-scripts build",
    "test": "react-scripts test --verbose",
    "test:cov": "npm test -- --coverage --watchAll",
    "eject": "react-scripts eject",
    "graphql:init": "graphql-codegen init",
    "graphql:gen": "graphql-codegen --config codegen.yml"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@testing-library/cypress": "^8.0.3",
    "@types/jest": "^28.1.1",
    "@types/leaflet": "^1.7.11",
    "autoprefixer": "^10.4.7",
    "jest": "^28.1.1",
    "postcss": "^8.4.14",
    "tailwindcss": "^3.0.24",
    "ts-jest": "^28.0.4"
  },
  "jest": {
    "collectCoverageFrom": [
      "./src/*.tsx",
      "./src/components/**/*.{ts,tsx}",
      "./src/pages/**/*.{ts,tsx}",
      "./src/routes/**/*.{ts,tsx}",
      "!public",
      "!<rootDir>/node_modules/",
      "!<rootDir>/path/to/dir/"
    ]
  }
}
